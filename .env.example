# Copy this file to `.env` and fill in your keys. Never commit `.env`.

# --- Primary LLM (ADR-003): Gemini via its OpenAI-compatible endpoint ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# The free tier allows 20 requests/day PER MODEL, so vision and copy use different
# models: two separate daily quotas, and the stronger model writes the copy (ADR-003).
VISION_MODEL=gemini-3.5-flash-lite
COPY_MODEL=gemini-3.5-flash
# Other Gemini models on the same key, tried in order if the main one fails
LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# --- Fallback LLM provider (optional): OpenRouter free models ---
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_API_KEY=
# Comma-separated, e.g. vendor/model-name:free
FALLBACK_MODELS=

# --- Scene backgrounds (ADR-007) ---
IMAGE_PROVIDER=pollinations

# --- Limits & cost display ---
LLM_TIMEOUT_S=60
MAX_REQUESTS_PER_MIN=10
# USD per 1M tokens of a reference paid model, used for the "equivalent cost" estimate
REFERENCE_PRICE_PER_MTOK=
